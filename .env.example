# LLM Configuration
LLM_API_KEY=your_api_key_here
LLM_API_URL=https://api.openai.com
LLM_BASE_MODEL=gpt-4

# OpenCTI Configuration
OPENCTI_API_KEY=your_opencti_api_key_here
OPENCTI_BASE_URL=https://your.opencti.instance/graphql

# Token Usage Limits
AGENT_DEFAULT_TOKEN_LIMIT=10000
SYSTEM_DAILY_TOKEN_LIMIT=100000

# Logging
LOG_LEVEL=INFO

# Optional: VirusTotal Integration
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here